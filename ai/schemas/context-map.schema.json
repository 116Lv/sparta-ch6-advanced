{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:context-map:v1",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "updatedAt", "routes", "surfaces", "generatedPaths", "excludedPaths"],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "const": "ai/context-map.json" },
    "schemaVersion": { "const": 1 },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "owningFeature", "requiredDocuments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "owningFeature": { "enum": ["FEATURE_REQUIRED", "NONE_ALLOWED", "DIRECT_DOCUMENT"] },
          "requiredDocuments": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/repositoryPath" }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/repositoryPath" }
          },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generatedPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "excludedPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/repositoryPath" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\).+$"
    }
  }
}

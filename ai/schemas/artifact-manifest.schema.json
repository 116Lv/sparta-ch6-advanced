{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:artifact-manifest:v1",
  "schemaVersion": 1,
  "title": "AI Workflow Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "runId", "generatedAt", "algorithm", "artifacts"],
  "properties": {
    "$schema": { "const": "ai/schemas/artifact-manifest.schema.json" },
    "$id": { "$ref": "#/$defs/repositoryPath" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/identifier" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "algorithm": { "const": "SHA-256" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "repositoryPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$)).+$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["COMMAND_RESULT", "PROCESS_ATTEMPT", "STDOUT_LOG", "STDERR_LOG", "APPROVAL", "POLICY_VIOLATION", "GATE_RESULT", "DONE_CLAIM"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:verification-policy:v1",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "updatedAt", "entryPoints", "checks", "changeTypes", "resultMapping"],
  "properties": {
    "$schema": { "enum": ["./schemas/verification-policy.schema.json", "ai/schemas/verification-policy.schema.json"] },
    "$id": { "const": "ai/verification-policy.json" },
    "schemaVersion": { "const": 1 },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "entryPoints": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/entryPoint" }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/check" },
      "contains": {
        "type": "object",
        "properties": { "id": { "const": "native-runtime-adapter" } },
        "required": ["id"]
      }
    },
    "changeTypes": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/changeType" }
    },
    "resultMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notConfiguredRequired", "notConfiguredOptional", "failRequired", "blockedRequired", "notApplicable"],
      "properties": {
        "notConfiguredRequired": { "const": "BLOCKED" },
        "notConfiguredOptional": { "const": "NOT_APPLICABLE" },
        "failRequired": { "const": "FAIL" },
        "blockedRequired": { "const": "BLOCKED" },
        "notApplicable": { "const": "NOT_APPLICABLE" }
      }
    }
  },
  "$defs": {
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "script"],
      "properties": {
        "id": { "enum": ["verification-level", "api-smoke", "failure-triage", "review", "done-claim"] },
        "purpose": { "type": "string", "minLength": 1 },
        "script": { "const": "scripts/ai/verification-gate.sh" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entryPoint", "registryCommandId", "producerId", "evidenceSchema", "notApplicableFor"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "entryPoint": { "enum": ["verification-level", "api-smoke", "failure-triage", "review", "done-claim"] },
        "registryCommandId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "producerId": {
          "enum": [
            "review-gate",
            "done-claim-gate",
            "failure-triage",
            "verify.static",
            "native-runtime-adapter",
            "verify.unit",
            "verify.integration",
            "verify.api-smoke",
            "verify.e2e"
          ]
        },
        "evidenceSchema": {
          "enum": [
            "ai/schemas/gateway-result.schema.json",
            "ai/schemas/command-result.schema.json",
            "ai/schemas/native-adapter-result.schema.json"
          ]
        },
        "notApplicableFor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["documentation-only", "static-workflow", "domain-logic", "db-api", "auth-permission", "critical-data", "user-flow"]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "id": { "const": "native-runtime-adapter" } },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "entryPoint": { "const": "verification-level" },
              "registryCommandId": { "type": "null" }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "id": { "const": "review-gate" },
                "producerId": { "const": "review-gate" },
                "evidenceSchema": { "const": "ai/schemas/gateway-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "done-claim-gate" },
                "producerId": { "const": "done-claim-gate" },
                "evidenceSchema": { "const": "ai/schemas/gateway-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "failure-triage" },
                "producerId": { "const": "failure-triage" },
                "evidenceSchema": { "const": "ai/schemas/gateway-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "verify.static" },
                "producerId": { "const": "verify.static" },
                "evidenceSchema": { "const": "ai/schemas/gateway-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "native-runtime-adapter" },
                "producerId": { "const": "native-runtime-adapter" },
                "evidenceSchema": { "const": "ai/schemas/native-adapter-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "verify.unit" },
                "producerId": { "const": "verify.unit" },
                "evidenceSchema": { "const": "ai/schemas/command-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "verify.integration" },
                "producerId": { "const": "verify.integration" },
                "evidenceSchema": { "const": "ai/schemas/command-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "verify.api-smoke" },
                "producerId": { "const": "verify.api-smoke" },
                "evidenceSchema": { "const": "ai/schemas/command-result.schema.json" }
              }
            },
            {
              "properties": {
                "id": { "const": "verify.e2e" },
                "producerId": { "const": "verify.e2e" },
                "evidenceSchema": { "const": "ai/schemas/command-result.schema.json" }
              }
            }
          ]
        }
      ]
    },
    "changeType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimumVerificationLevel", "entryPoints", "requiredChecks", "optionalChecks", "applicabilityReason"],
      "properties": {
        "id": { "enum": ["documentation-only", "static-workflow", "domain-logic", "db-api", "auth-permission", "critical-data", "user-flow"] },
        "minimumVerificationLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["verification-level", "api-smoke", "failure-triage", "review", "done-claim"] }
        },
        "requiredChecks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "contains": { "const": "native-runtime-adapter" }
        },
        "optionalChecks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
        },
        "applicabilityReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

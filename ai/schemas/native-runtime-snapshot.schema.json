{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:native-runtime-snapshot:v1",
  "schemaVersion": 1,
  "title": "Native Runtime Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "producerId", "hostId", "hostVersion", "adapterVersion", "observedAt", "gateInvocationId", "resolutionEventIds", "surfaces", "publicKey", "signature"],
  "properties": {
    "$schema": { "const": "ai/schemas/native-runtime-snapshot.schema.json" },
    "$id": { "const": "ai/native-runtime-snapshot.json" },
    "schemaVersion": { "const": 1 },
    "producerId": { "$ref": "#/$defs/identifier" },
    "hostId": { "$ref": "#/$defs/identifier" },
    "hostVersion": { "$ref": "#/$defs/version" },
    "adapterVersion": { "$ref": "#/$defs/version" },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "gateInvocationId": { "$ref": "#/$defs/identifier" },
    "resolutionEventIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier", "maxLength": 128 }
    },
    "surfaces": { "$ref": "#/$defs/fourSurfaces" },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "fingerprintSha256", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "encoding": { "const": "RAW_BASE64" },
        "fingerprintSha256": { "$ref": "#/$defs/digest" },
        "value": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=(?![\\s\\S])"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "encoding": { "const": "BASE64" },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==(?![\\s\\S])"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "surfaceName": { "enum": ["COMMAND", "FILE_READ", "SEARCH", "TOOL_CALL"] },
    "callbackProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateInvocationId", "observedBeforeOperation", "challengeResult"],
      "properties": {
        "gateInvocationId": { "$ref": "#/$defs/identifier" },
        "observedBeforeOperation": { "type": "boolean" },
        "challengeResult": { "enum": ["BLOCKED", "FAILED"] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "status", "reasonCode", "callbackProof"],
      "properties": {
        "surface": { "$ref": "#/$defs/surfaceName" },
        "status": { "enum": ["NOT_CONFIGURED", "AUDIT_ONLY", "ENFORCED"] },
        "reasonCode": { "$ref": "#/$defs/identifier" },
        "callbackProof": {
          "anyOf": [
            { "$ref": "#/$defs/callbackProof" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ENFORCED" } }, "required": ["status"] },
          "then": { "properties": { "callbackProof": { "$ref": "#/$defs/callbackProof" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["NOT_CONFIGURED", "AUDIT_ONLY"] } }, "required": ["status"] },
          "then": { "properties": { "callbackProof": { "type": "null" } } }
        }
      ]
    },
    "fourSurfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/surface" },
      "allOf": [
        { "contains": { "properties": { "surface": { "const": "COMMAND" } }, "required": ["surface"] } },
        { "contains": { "properties": { "surface": { "const": "FILE_READ" } }, "required": ["surface"] } },
        { "contains": { "properties": { "surface": { "const": "SEARCH" } }, "required": ["surface"] } },
        { "contains": { "properties": { "surface": { "const": "TOOL_CALL" } }, "required": ["surface"] } }
      ]
    }
  }
}

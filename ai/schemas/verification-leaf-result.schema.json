{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:verification-leaf-result:v1",
  "schemaVersion": 1,
  "title": "AI Workflow Verification Leaf Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "checkId",
    "result",
    "taskKey",
    "gateInvocationId",
    "commitSha",
    "policySha256",
    "producerId",
    "producedAt",
    "expiresAt",
    "evidence",
    "reason"
  ],
  "properties": {
    "$schema": { "const": "ai/schemas/verification-leaf-result.schema.json" },
    "$id": { "$ref": "#/$defs/repositoryPath" },
    "schemaVersion": { "const": 1 },
    "checkId": { "$ref": "#/$defs/checkId" },
    "result": { "$ref": "#/$defs/result" },
    "taskKey": { "$ref": "#/$defs/identifier" },
    "gateInvocationId": { "$ref": "#/$defs/identifier" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}(?![\\s\\S])" },
    "policySha256": { "$ref": "#/$defs/digest" },
    "producerId": { "$ref": "#/$defs/checkId" },
    "producedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "evidence": {
      "oneOf": [
        { "$ref": "#/$defs/evidence" },
        { "type": "null" }
      ]
    },
    "reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "enum": ["PASS", "FAIL"] } },
        "required": ["result"]
      },
      "then": {
        "properties": { "evidence": { "$ref": "#/$defs/evidence" } }
      }
    }
  ],
  "$defs": {
    "checkId": {
      "enum": [
        "review-gate",
        "done-claim-gate",
        "failure-triage",
        "verify.static",
        "native-runtime-adapter",
        "verify.unit",
        "verify.integration",
        "verify.api-smoke",
        "verify.e2e"
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_CONFIGURED",
        "NOT_APPLICABLE",
        "SKIPPED_WITH_REASON"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$)).+(?![\\s\\S])"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "schema", "sha256"],
      "properties": {
        "ref": { "$ref": "#/$defs/repositoryPath" },
        "schema": {
          "enum": [
            "ai/schemas/gateway-result.schema.json",
            "ai/schemas/command-result.schema.json",
            "ai/schemas/native-adapter-result.schema.json"
          ]
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:agent-handoff:v2",
  "schemaVersion": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "updatedAt", "routeId", "taskPhase", "owningFeature", "contextStatus", "repositoryContextRequired", "activityId", "rediscoverySubjects", "selectedDocuments", "activatedTriggers", "readDocuments", "deferredDocuments", "deferredDocumentTriggers", "includePaths", "deferredPaths", "decisions", "openQuestions", "remainingWork", "remainingVerificationEvidence", "rerouteTriggers", "reusableContextRefs", "skillCatalogRef", "skillIds", "activeIssue", "githubIssue", "phase3AIssue", "notRunProjectCommands", "laterPhaseBoundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "const": "ai/agent-handoff.json" },
    "schemaVersion": { "const": 2 },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "routeId": { "enum": ["answer", "light-structure", "feature-work", "repo-wide-ai-workflow"] },
    "taskPhase": { "enum": ["answer", "light-structure", "feature-requirements", "implementation", "verification", "completion", "workflow-rediscovery"] },
    "owningFeature": {
      "oneOf": [
        { "const": "none" },
        { "type": "string", "pattern": "^specs/[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])" }
      ]
    },
    "contextStatus": { "enum": ["READY", "PARTIAL", "BLOCKED"] },
    "repositoryContextRequired": { "type": "boolean" },
    "activityId": { "$ref": "#/$defs/activityId" },
    "rediscoverySubjects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rediscoverySubjectId" }
    },
    "selectedDocuments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactRepositoryPath" }
    },
    "activatedTriggers": { "$ref": "#/$defs/stringArray" },
    "readDocuments": { "$ref": "#/$defs/pathArray" },
    "deferredDocuments": { "$ref": "#/$defs/pathArray" },
    "deferredDocumentTriggers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "documents"],
        "properties": {
          "trigger": { "type": "string", "minLength": 1 },
          "documents": { "$ref": "#/$defs/nonEmptyPathArray" }
        }
      }
    },
    "includePaths": { "$ref": "#/$defs/pathScopeArray" },
    "deferredPaths": { "$ref": "#/$defs/pathScopeArray" },
    "decisions": { "$ref": "#/$defs/stringArray" },
    "openQuestions": { "$ref": "#/$defs/stringArray" },
    "remainingWork": { "$ref": "#/$defs/stringArray" },
    "remainingVerificationEvidence": { "$ref": "#/$defs/stringArray" },
    "rerouteTriggers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "reusableContextRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactRepositoryPath" }
    },
    "skillCatalogRef": { "const": "ai/skill-catalog.json" },
    "skillIds": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["repo-intake", "command-runner", "verification-runner", "api-smoke-verifier", "failure-triage", "docs-sync", "review-gate"] }
    },
    "activeIssue": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "issueUrl", "summaryRef", "roleLogRefs"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "issueUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/116Lv/sparta-ch6-advanced/issues/[1-9][0-9]*(?![\\s\\S])"
            },
            "summaryRef": {
              "allOf": [
                { "$ref": "#/$defs/exactRepositoryPath" },
                { "pattern": "^ai/work-logs/issue-[1-9][0-9]*/README\\.md$" }
              ]
            },
            "roleLogRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/exactRepositoryPath" },
                  { "pattern": "^ai/work-logs/issue-[1-9][0-9]*/.+$" }
                ]
              }
            }
          }
        }
      ]
    },
    "githubIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "issueUrl", "trackingStatus", "reconciliationRequired", "reconciliationCommentUrl", "previousReconciliationError"],
      "properties": {
        "issueNumber": { "const": 7 },
        "issueUrl": { "const": "https://github.com/116Lv/sparta-ch6-advanced/issues/7" },
        "trackingStatus": { "const": "issue_backed" },
        "reconciliationRequired": { "const": false },
        "reconciliationCommentUrl": { "const": "https://github.com/116Lv/sparta-ch6-advanced/issues/7#issuecomment-4953424231" },
        "previousReconciliationError": { "const": "authorization failure: GitHub API 403 Resource not accessible by integration" }
      }
    },
    "phase3AIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "issueUrl", "trackingStatus"],
      "properties": {
        "issueNumber": { "const": 10 },
        "issueUrl": { "const": "https://github.com/116Lv/sparta-ch6-advanced/issues/10" },
        "trackingStatus": { "const": "issue_backed" }
      }
    },
    "notRunProjectCommands": {
      "const": [
        "Gradle",
        "build",
        "product/unit project tests",
        "application server",
        "Docker Compose",
        "HTTP/curl/API",
        "database",
        "migration",
        "seed",
        "infrastructure commands"
      ]
    },
    "laterPhaseBoundaries": { "$ref": "#/$defs/nonEmptyStringArray" }
  },
  "oneOf": [
    {
      "properties": {
        "routeId": { "const": "answer" },
        "taskPhase": { "const": "answer" },
        "owningFeature": { "const": "none" }
      }
    },
    {
      "properties": {
        "routeId": { "const": "light-structure" },
        "taskPhase": { "const": "light-structure" },
        "owningFeature": { "const": "none" }
      }
    },
    {
      "properties": {
        "routeId": { "const": "feature-work" },
        "taskPhase": { "enum": ["feature-requirements", "implementation", "verification", "completion"] },
        "owningFeature": {
          "type": "string",
          "pattern": "^specs/[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        }
      }
    },
    {
      "properties": {
        "routeId": { "const": "repo-wide-ai-workflow" },
        "taskPhase": { "enum": ["implementation", "verification", "completion", "workflow-rediscovery"] },
        "owningFeature": { "const": "none" }
      }
    }
  ],
  "$defs": {
    "activityId": {
      "enum": ["ANSWER", "DOCUMENT_EDIT", "REQUIREMENTS", "PLANNING", "EXECUTION", "VERIFICATION_HANDOFF", "INDEPENDENT_AUDIT", "COMPLETION", "REDISCOVERY"]
    },
    "rediscoverySubjectId": {
      "enum": ["ROUTING_POLICY", "CACHE_POLICY", "WORKFLOW_CACHE_STATE", "TOOL_POLICY", "RESOURCE_BUDGET", "PROJECT_STATE", "COMMAND_REGISTRY"]
    },
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "nonEmptyPathArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "pathScopeArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathScope" }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^(?!/)(?!.*[/]$)(?!.*//)(?!.*:)(?!.*%)(?!.*[?*\\[\\]])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
        },
        {
          "oneOf": [
            { "pattern": "^[^{}]+$" },
            { "pattern": "^specs/\\{feature\\}/[^{}]+$" }
          ]
        }
      ]
    },
    "exactRepositoryPath": {
      "allOf": [
        { "$ref": "#/$defs/repositoryPath" },
        { "pattern": "^[^{}]+$" }
      ]
    },
    "scopePath": {
      "allOf": [
        { "$ref": "#/$defs/repositoryPath" },
        { "pattern": "^[^{}]+$" }
      ]
    },
    "pathScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "exact" },
            "path": { "$ref": "#/$defs/repositoryPath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "subtree" },
            "path": { "$ref": "#/$defs/scopePath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "suffix"],
          "properties": {
            "kind": { "const": "direct-children" },
            "path": { "$ref": "#/$defs/scopePath" },
            "suffix": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "descendant-directory" },
            "name": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$" }
          }
        }
      ]
    }
  }
}

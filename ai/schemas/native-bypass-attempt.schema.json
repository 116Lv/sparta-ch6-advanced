{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:native-bypass-attempt:v1",
  "schemaVersion": 1,
  "title": "Native Adapter Bypass Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "attemptId", "eventId", "observedAt", "hostId", "hostVersion", "adapterVersion", "surface", "operationType", "statusAtObservation", "decision", "reasonCode", "repositoryGatewayExpected", "taskKey", "gateInvocationId", "runId", "deduplicationKey", "lifecycle", "resolvedAt", "resolutionReason", "summary"],
  "properties": {
    "$schema": { "const": "ai/schemas/native-bypass-attempt.schema.json" },
    "$id": { "const": "ai/native-bypass-attempt.json" },
    "schemaVersion": { "const": 1 },
    "attemptId": { "$ref": "#/$defs/identifier" },
    "eventId": { "$ref": "#/$defs/identifier" },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "hostId": { "$ref": "#/$defs/identifier" },
    "hostVersion": { "$ref": "#/$defs/version" },
    "adapterVersion": { "$ref": "#/$defs/version" },
    "surface": { "enum": ["COMMAND", "FILE_READ", "SEARCH", "TOOL_CALL"] },
    "operationType": { "enum": ["COMMAND", "FILE_READ", "SEARCH", "TOOL_CALL"] },
    "commandIntent": { "enum": ["COMMAND", "FILE_READ", "SEARCH", "TOOL_CALL"] },
    "statusAtObservation": { "enum": ["ENFORCED", "AUDIT_ONLY"] },
    "decision": { "enum": ["BLOCKED", "ALLOWED_AUDIT_ONLY"] },
    "reasonCode": { "$ref": "#/$defs/identifier" },
    "repositoryGatewayExpected": { "type": "boolean" },
    "taskKey": { "$ref": "#/$defs/identifier", "maxLength": 128 },
    "gateInvocationId": { "$ref": "#/$defs/identifier" },
    "runId": { "anyOf": [{ "$ref": "#/$defs/identifier", "maxLength": 128 }, { "type": "null" }] },
    "deduplicationKey": { "$ref": "#/$defs/identifier", "maxLength": 256 },
    "lifecycle": { "enum": ["DETECTED", "RESOLVED"] },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
    "resolutionReason": { "type": ["string", "null"], "enum": [null, "FALSE_POSITIVE", "REMEDIATED", "DUPLICATE_EVENT"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "argumentSummary", "querySummary", "toolPayloadSummary"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 512 },
        "argumentSummary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "querySummary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "toolPayloadSummary": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "DETECTED" } }, "required": ["lifecycle"] },
      "then": { "properties": { "resolvedAt": { "const": null }, "resolutionReason": { "const": null } } }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "RESOLVED" } }, "required": ["lifecycle"] },
      "then": {
        "properties": {
          "resolvedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" },
          "resolutionReason": { "enum": ["FALSE_POSITIVE", "REMEDIATED", "DUPLICATE_EVENT"] }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\Z" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:run-session:v1",
  "schemaVersion": 1,
  "title": "AI Workflow Run Session And Finalization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "runId", "taskKey", "startedAt", "workingDirectory", "environment", "state", "commandResultRefs", "processAttemptRefs", "approvalRefs", "policyViolationRefs", "gateResultRefs", "reservations", "lockRecoveries", "redactionApplied", "finalizationReceipt"],
  "properties": {
    "$schema": { "const": "ai/schemas/run-session.schema.json" },
    "$id": { "$ref": "#/$defs/repositoryPath" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/identifier" },
    "taskKey": { "type": "string", "minLength": 1 },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "workingDirectory": { "$ref": "#/$defs/repositoryPath" },
    "environment": { "enum": ["LOCAL", "CI"] },
    "state": { "enum": ["OPEN", "FINALIZING", "FINALIZED"] },
    "commandResultRefs": { "$ref": "#/$defs/referenceList" },
    "processAttemptRefs": { "$ref": "#/$defs/referenceList" },
    "approvalRefs": { "$ref": "#/$defs/referenceList" },
    "policyViolationRefs": { "$ref": "#/$defs/referenceList" },
    "gateResultRefs": { "$ref": "#/$defs/referenceList" },
    "reservations": {
      "type": "array",
      "items": { "$ref": "#/$defs/reservation" }
    },
    "lockRecoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/lockRecovery" }
    },
    "redactionApplied": { "type": "boolean" },
    "finalizationReceipt": { "oneOf": [{ "$ref": "#/$defs/finalizationReceipt" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["OPEN", "FINALIZING"] } }, "required": ["state"] },
      "then": { "properties": { "finalizationReceipt": { "type": "null" } } }
    },
    {
      "if": { "properties": { "state": { "const": "FINALIZED" } }, "required": ["state"] },
      "then": { "properties": { "finalizationReceipt": { "$ref": "#/$defs/finalizationReceipt" } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "commandId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "referenceList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "workflowResult": {
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_CONFIGURED", "NOT_APPLICABLE", "SKIPPED_WITH_REASON"]
    },
    "artifactKind": {
      "enum": ["COMMAND_RESULT", "PROCESS_ATTEMPT", "STDOUT_LOG", "STDERR_LOG", "APPROVAL", "POLICY_VIOLATION", "GATE_RESULT", "DONE_CLAIM"]
    },
    "finalRunProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "$id", "schemaVersion", "runId", "taskKey", "startedAt", "endedAt", "workingDirectory", "environment", "result", "commandResultRefs", "approvalRefs", "policyViolationRefs", "evidenceRefs", "redactionApplied", "reason"],
      "properties": {
        "$schema": { "const": "ai/schemas/run.schema.json" },
        "$id": { "$ref": "#/$defs/repositoryPath" },
        "schemaVersion": { "const": 1 },
        "runId": { "$ref": "#/$defs/identifier" },
        "taskKey": { "type": "string", "minLength": 1 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "endedAt": { "$ref": "#/$defs/timestamp" },
        "workingDirectory": { "$ref": "#/$defs/repositoryPath" },
        "environment": { "enum": ["LOCAL", "CI"] },
        "result": { "$ref": "#/$defs/workflowResult" },
        "commandResultRefs": { "$ref": "#/$defs/referenceList" },
        "approvalRefs": { "$ref": "#/$defs/referenceList" },
        "policyViolationRefs": { "$ref": "#/$defs/referenceList" },
        "evidenceRefs": { "$ref": "#/$defs/referenceList" },
        "redactionApplied": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "finalizationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestIdentity", "runProjection", "claimIdentity", "gateIdentity", "artifactIdentities"],
      "properties": {
        "manifestIdentity": {
          "type": "object", "additionalProperties": false, "required": ["$id", "runId"],
          "properties": { "$id": { "$ref": "#/$defs/repositoryPath" }, "runId": { "$ref": "#/$defs/identifier" } }
        },
        "runProjection": { "$ref": "#/$defs/finalRunProjection" },
        "claimIdentity": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "canonicalSha256", "implementationStatus", "overallResult", "unexpected500Status", "unhandledExceptionStatus"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "canonicalSha256": { "$ref": "#/$defs/digest" },
            "implementationStatus": { "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"] },
            "overallResult": { "$ref": "#/$defs/workflowResult" },
            "unexpected500Status": { "$ref": "#/$defs/workflowResult" },
            "unhandledExceptionStatus": { "$ref": "#/$defs/workflowResult" }
          }
        },
        "gateIdentity": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "canonicalSha256", "operation", "result", "reason"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "canonicalSha256": { "$ref": "#/$defs/digest" },
            "operation": { "const": "PRE_DONE_CLAIM" },
            "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_CONFIGURED", "POLICY_VIOLATION", "INVALID_STATE"] },
            "reason": { "type": ["string", "null"] }
          }
        },
        "artifactIdentities": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "kind"],
            "properties": { "path": { "$ref": "#/$defs/repositoryPath" }, "kind": { "$ref": "#/$defs/artifactKind" } }
          }
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "commandId", "argvHash", "inputFingerprint", "environmentFingerprint", "reservedAt", "state", "commandResultRef", "processAttemptRef", "terminalAt", "rerunReasonHash", "rerunOfAttemptId"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/identifier" },
        "commandId": { "$ref": "#/$defs/commandId" },
        "argvHash": { "$ref": "#/$defs/digest" },
        "inputFingerprint": { "$ref": "#/$defs/digest" },
        "environmentFingerprint": { "$ref": "#/$defs/digest" },
        "reservedAt": { "$ref": "#/$defs/timestamp" },
        "state": { "enum": ["RESERVED", "PASS", "FAIL", "BLOCKED"] },
        "commandResultRef": { "oneOf": [{ "$ref": "#/$defs/repositoryPath" }, { "type": "null" }] },
        "processAttemptRef": { "oneOf": [{ "$ref": "#/$defs/repositoryPath" }, { "type": "null" }] },
        "terminalAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "rerunReasonHash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "rerunOfAttemptId": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "RESERVED" } }, "required": ["state"] },
          "then": {
            "properties": {
              "commandResultRef": { "type": "null" },
              "processAttemptRef": { "type": "null" },
              "terminalAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["PASS", "FAIL", "BLOCKED"] } }, "required": ["state"] },
          "then": {
            "properties": {
              "commandResultRef": { "$ref": "#/$defs/repositoryPath" },
              "processAttemptRef": { "$ref": "#/$defs/repositoryPath" },
              "terminalAt": { "$ref": "#/$defs/timestamp" }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "rerunReasonHash": { "type": "null" },
                "rerunOfAttemptId": { "type": "null" }
              }
            },
            {
              "properties": {
                "rerunReasonHash": { "$ref": "#/$defs/digest" },
                "rerunOfAttemptId": { "$ref": "#/$defs/identifier" }
              }
            }
          ]
        }
      ]
    },
    "lockRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recoveryId", "runId", "recoveredOwnerId", "replacementOwnerId", "previousPid", "previousAcquiredAt", "recoveredAt", "reason"],
      "properties": {
        "recoveryId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "recoveredOwnerId": { "$ref": "#/$defs/identifier" },
        "replacementOwnerId": { "$ref": "#/$defs/identifier" },
        "previousPid": { "type": "integer", "minimum": 1 },
        "previousAcquiredAt": { "$ref": "#/$defs/timestamp" },
        "recoveredAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "const": "DEAD_AND_EXPIRED" }
      }
    }
  }
}

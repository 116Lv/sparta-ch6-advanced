{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:host-native-trust:v1",
  "schemaVersion": 1,
  "title": "Host Native Trust Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "producerId",
    "hostId",
    "minimumHostVersion",
    "adapterVersionRange",
    "ed25519PublicKeyFingerprint",
    "surfaces"
  ],
  "properties": {
    "$schema": { "const": "ai/schemas/host-native-trust.schema.json" },
    "schemaVersion": { "const": 1 },
    "producerId": { "$ref": "#/$defs/identifier" },
    "hostId": { "$ref": "#/$defs/identifier" },
    "minimumHostVersion": { "$ref": "#/$defs/version" },
    "adapterVersionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^>=\\S+ <\\S+(?![\\s\\S])"
    },
    "ed25519PublicKeyFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "surfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/surfaceName" },
      "allOf": [
        { "contains": { "const": "COMMAND" } },
        { "contains": { "const": "FILE_READ" } },
        { "contains": { "const": "SEARCH" } },
        { "contains": { "const": "TOOL_CALL" } }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "surfaceName": { "enum": ["COMMAND", "FILE_READ", "SEARCH", "TOOL_CALL"] },
    "authoritativeProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "hostVersion", "versionProvenance", "producerId", "observedAt"],
      "properties": {
        "hostId": { "$ref": "#/$defs/identifier" },
        "hostVersion": { "$ref": "#/$defs/version" },
        "versionProvenance": { "const": "PROBED" },
        "producerId": { "$ref": "#/$defs/identifier" },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z(?![\\s\\S])"
        }
      }
    }
  }
}

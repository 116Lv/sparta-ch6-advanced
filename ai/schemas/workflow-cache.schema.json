{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparta-ch6-advanced:ai-workflow:schema:workflow-cache:v1",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "updatedAt", "entries", "handoffNotes", "invalidationEvents"],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "const": "ai/workflow-cache.json" },
    "schemaVersion": { "const": 1 },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/cacheEntry" }
    },
    "handoffNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoffNote" }
    },
    "invalidationEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/invalidationEvent" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\).+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cacheEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "key", "summary", "evidenceRefs", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "enum": ["FILE_DISCOVERY", "COMMAND_EVIDENCE_SUMMARY", "HANDOFF_CONTEXT"] },
        "status": { "enum": ["FRESH", "STALE", "UNCERTAIN"] },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "environmentFingerprint"],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "$ref": "#/$defs/repositoryPath" },
                  "sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            },
            "environmentFingerprint": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/sha256" }
              ]
            }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      }
    },
    "handoffNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      }
    },
    "invalidationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "status", "reason", "detectedAt"],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "status": { "enum": ["STALE", "UNCERTAIN"] },
        "reason": { "type": "string", "minLength": 1 },
        "detectedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      }
    }
  }
}

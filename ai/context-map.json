      "description": "Feature-owned requirements, implementation, verification, and completion work.",
      "owningFeature": "FEATURE_REQUIRED",
      "phases": [
        {
          "id": "feature-requirements",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": ["specs/{feature}/spec.md"],
          "deferredDocuments": ["specs/{feature}/plan.md", "specs/{feature}/tasks.md", "specs/{feature}/decisions.md", "specs/{feature}/checklist.md"],
          "deferredDocumentTriggers": [
            { "trigger": "Implementation planning begins.", "documents": ["specs/{feature}/plan.md"] },
            { "trigger": "Execution or verification handoff begins.", "documents": ["specs/{feature}/tasks.md"] },
            { "trigger": "An existing decision must be confirmed or a new decision is required.", "documents": ["specs/{feature}/decisions.md"] },
            { "trigger": "The completion sequence begins.", "documents": ["specs/{feature}/checklist.md"] }
          ],
          "activityRequirements": [{ "activityId": "REQUIREMENTS", "mandatoryTriggers": [] }],
          "rediscoverySubjects": [],

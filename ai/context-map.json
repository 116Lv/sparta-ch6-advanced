            { "activityId": "EXECUTION", "mandatoryTriggers": ["Route, cache, tool, or resource policy is being changed or rediscovered."] },
            { "activityId": "VERIFICATION_HANDOFF", "mandatoryTriggers": ["Route, cache, tool, or resource policy is being changed or rediscovered."] }

          "optInPaths": [
            { "path": { "kind": "subtree", "path": "ai/fixtures" }, "trigger": "A directly related verification fixture is required." },
            { "path": { "kind": "subtree", "path": "ai/schemas" }, "trigger": "A directly related verification schema is required." },
            { "path": { "kind": "subtree", "path": "ai/work-logs" }, "trigger": "Only the active Issue summary and verification role log are needed." }
          ],
          "rerouteTriggers": ["verification scope is ambiguous", "implementation resumes", "completion begins", "route or cache rediscovery begins"]
        },
        {
          "id": "completion",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": ["AGENTS.md", "ai/document-routing.md"],
          "deferredDocuments": ["ai/qa-gate.md", "ai/done-claim-template.md", "ai/issue-completion-checklist.md"],
          "deferredDocumentTriggers": [
            { "trigger": "The QA gate is applied.", "documents": ["ai/qa-gate.md"] },
            { "trigger": "An evidence-based done claim is prepared.", "documents": ["ai/done-claim-template.md"] },
            { "trigger": "Issue closure readiness is evaluated.", "documents": ["ai/issue-completion-checklist.md"] }
          ],
          "activityRequirements": [{ "activityId": "COMPLETION", "mandatoryTriggers": ["The QA gate is applied.", "An evidence-based done claim is prepared.", "Issue closure readiness is evaluated."] }],
          "rediscoverySubjects": [],
          "includePaths": [{ "kind": "exact", "path": "AGENTS.md" }, { "kind": "exact", "path": "ai/document-routing.md" }],
          "optInPaths": [

{
  "$schema": "./schemas/context-map.schema.json",
  "$id": "ai/context-map.json",
  "schemaVersion": 2,
  "updatedAt": "2026-07-15T00:00:00Z",
  "routes": [
    {
      "id": "answer",
      "description": "Small questions and explanations with no repository change.",
      "owningFeature": "NONE_ALLOWED",
      "phases": [
        {
          "id": "answer",
          "repositoryContextMode": "OPTIONAL",
          "requiredDocuments": [],
          "deferredDocuments": [],
          "deferredDocumentTriggers": [],
          "activityRequirements": [{ "activityId": "ANSWER", "mandatoryTriggers": [] }],
          "rediscoverySubjects": [],
          "includePaths": [],
          "optInPaths": [],
          "rerouteTriggers": ["repository change", "normative decision", "verification request", "completion claim"]
        }
      ]
    },
    {
      "id": "light-structure",
      "description": "Narrow structure discovery, first explanation, or non-normative wording maintenance.",
      "owningFeature": "DIRECT_DOCUMENT",
      "phases": [
        {
          "id": "light-structure",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": [],
          "deferredDocuments": ["README.md", "docs/00-index.md"],
          "deferredDocumentTriggers": [
            {
              "trigger": "First-time onboarding or broad repository mapping is necessary.",
              "documents": ["README.md", "docs/00-index.md"]
            }
          ],
          "activityRequirements": [{ "activityId": "DOCUMENT_EDIT", "mandatoryTriggers": [] }],
          "rediscoverySubjects": [],
          "includePaths": [],
          "optInPaths": [],
          "rerouteTriggers": ["requirements change", "behavior change", "contract change", "architecture change", "verification policy change"]
        }
      ]
    },
    {

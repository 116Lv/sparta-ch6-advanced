  "surfaces": [
    { "id": "product-source", "paths": ["src/main"], "owner": "product feature specs" },
    { "id": "product-tests", "paths": ["src/test"], "owner": "product feature specs" },
    { "id": "feature-specs", "paths": ["specs"], "owner": "owning feature" },
    { "id": "ai-workflow", "paths": ["ai", "scripts/ai"], "owner": "repo-wide AI workflow" },
    { "id": "project-docs", "paths": ["docs", "README.md"], "owner": "documentation routes" }
  ],
  "generatedPaths": ["ai/project-state.md", "ai/command-registry.md", "ai/workflow-cache.md"],
  "deferredPaths": [{ "kind": "subtree", "path": "ai/work-logs" }, { "kind": "subtree", "path": "ai/fixtures" }, { "kind": "subtree", "path": "ai/schemas" }, { "kind": "subtree", "path": "docs/superpowers" }],
  "excludedPaths": [{ "kind": "subtree", "path": ".ai-runs" }, { "kind": "subtree", "path": ".git" }, { "kind": "descendant-directory", "name": "__pycache__" }, { "kind": "subtree", "path": "build" }, { "kind": "subtree", "path": ".gradle" }, { "kind": "subtree", "path": ".idea" }, { "kind": "subtree", "path": ".worktrees" }]

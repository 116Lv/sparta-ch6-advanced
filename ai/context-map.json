          ],
          "rerouteTriggers": ["required completion evidence is missing", "verification must resume", "implementation must resume"]
        },
        {
          "id": "workflow-rediscovery",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": ["ai/context-map.json"],
          "deferredDocuments": ["ai/context-map.md", "ai/cache-policy.md", "ai/workflow-cache.md", "ai/workflow-cache.json", "ai/tool-call-policy.md", "ai/resource-budget.md", "ai/project-state.json", "ai/command-registry.json"],
          "deferredDocumentTriggers": [
            { "trigger": "Routing policy is being rediscovered.", "documents": ["ai/context-map.md"] },
            { "trigger": "Cache policy is being rediscovered.", "documents": ["ai/cache-policy.md"] },
            { "trigger": "Workflow cache state is being rediscovered.", "documents": ["ai/workflow-cache.md", "ai/workflow-cache.json"] },
            { "trigger": "Tool-call policy is being rediscovered.", "documents": ["ai/tool-call-policy.md"] },
            { "trigger": "Resource budget policy is being rediscovered.", "documents": ["ai/resource-budget.md"] },
            { "trigger": "Project state is being rediscovered.", "documents": ["ai/project-state.json"] },
            { "trigger": "Command registry state is being rediscovered.", "documents": ["ai/command-registry.json"] }
          ],
          "activityRequirements": [{ "activityId": "REDISCOVERY", "mandatoryTriggers": [] }],
          "rediscoverySubjects": [
            { "id": "ROUTING_POLICY", "trigger": "Routing policy is being rediscovered.", "documents": ["ai/context-map.md"] },
            { "id": "CACHE_POLICY", "trigger": "Cache policy is being rediscovered.", "documents": ["ai/cache-policy.md"] },
            { "id": "WORKFLOW_CACHE_STATE", "trigger": "Workflow cache state is being rediscovered.", "documents": ["ai/workflow-cache.md", "ai/workflow-cache.json"] },
            { "id": "TOOL_POLICY", "trigger": "Tool-call policy is being rediscovered.", "documents": ["ai/tool-call-policy.md"] },
            { "id": "RESOURCE_BUDGET", "trigger": "Resource budget policy is being rediscovered.", "documents": ["ai/resource-budget.md"] },
            { "id": "PROJECT_STATE", "trigger": "Project state is being rediscovered.", "documents": ["ai/project-state.json"] },
            { "id": "COMMAND_REGISTRY", "trigger": "Command registry state is being rediscovered.", "documents": ["ai/command-registry.json"] }
          ],
          "includePaths": [{ "kind": "exact", "path": "ai/context-map.json" }],
          "optInPaths": [
            { "path": { "kind": "subtree", "path": "ai/schemas" }, "trigger": "The canonical route or cache schema is being changed." },
            { "path": { "kind": "subtree", "path": "ai/fixtures" }, "trigger": "A directly related workflow fixture is required." },
            { "path": { "kind": "subtree", "path": "docs/superpowers" }, "trigger": "A directly relevant historical design decision must be confirmed." }
          ],
          "rerouteTriggers": ["implementation begins", "verification begins", "completion begins", "task ownership changes"]
        }
      ]

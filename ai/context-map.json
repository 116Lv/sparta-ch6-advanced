          ],
          "rerouteTriggers": ["implementation planning", "implementation begins", "verification begins", "completion begins"]
        },
        {
          "id": "implementation",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": ["specs/{feature}/spec.md"],

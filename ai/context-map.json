            { "trigger": "The applicable verification level or gate must be determined.", "documents": ["ai/verification-levels.md", "ai/verification-gates.md", "ai/verification-policy.json"] },
            { "trigger": "The completion sequence begins after verification.", "documents": ["specs/{feature}/checklist.md", "ai/qa-gate.md", "ai/done-claim-template.md", "ai/issue-completion-checklist.md"] }
          ],
          "activityRequirements": [
            { "activityId": "INDEPENDENT_AUDIT", "mandatoryTriggers": ["The applicable verification level or gate must be determined."] },
            { "activityId": "VERIFICATION_HANDOFF", "mandatoryTriggers": ["Verification handoff requires the execution task record.", "The applicable verification level or gate must be determined."] }
          ],
          "rediscoverySubjects": [],
          "includePaths": [{ "kind": "exact", "path": "specs/{feature}/spec.md" }, { "kind": "subtree", "path": "src/test" }],
          "optInPaths": [
            { "path": { "kind": "subtree", "path": "ai/work-logs" }, "trigger": "Only the active Issue summary and verification role log are needed." },
            { "path": { "kind": "subtree", "path": "ai/fixtures" }, "trigger": "A directly related verification fixture is required." }
          ],
          "rerouteTriggers": ["verification scope is ambiguous", "requirements change", "implementation resumes", "completion begins"]
        },
        {
          "id": "completion",
          "repositoryContextMode": "REQUIRED",
          "requiredDocuments": ["specs/{feature}/spec.md"],
          "deferredDocuments": ["specs/{feature}/checklist.md", "ai/qa-gate.md", "ai/done-claim-template.md", "ai/issue-completion-checklist.md"],
          "deferredDocumentTriggers": [
            { "trigger": "Feature completion criteria are evaluated.", "documents": ["specs/{feature}/checklist.md"] },
            { "trigger": "The QA gate is applied.", "documents": ["ai/qa-gate.md"] },
            { "trigger": "An evidence-based done claim is prepared.", "documents": ["ai/done-claim-template.md"] },
            { "trigger": "Issue closure readiness is evaluated.", "documents": ["ai/issue-completion-checklist.md"] }
          ],
          "activityRequirements": [{ "activityId": "COMPLETION", "mandatoryTriggers": ["Feature completion criteria are evaluated.", "The QA gate is applied.", "An evidence-based done claim is prepared.", "Issue closure readiness is evaluated."] }],
          "rediscoverySubjects": [],
          "includePaths": [{ "kind": "exact", "path": "specs/{feature}/spec.md" }],
          "optInPaths": [
            { "path": { "kind": "subtree", "path": "ai/work-logs" }, "trigger": "Only the active Issue summary and completion role log are needed." }
          ],
          "rerouteTriggers": ["required completion evidence is missing", "verification must resume", "implementation must resume", "owning feature changes"]
        }
      ]
    },
    {
